#このファイルをコピーして.envに名前を変更する．

# rosのバージョンを指定（例: humble, iron, jazzy）
# 未指定の IMAGE_NAME は start_script が自動補完します：
#   - humble / iron -> ubuntu:22.04
#   - jazzy        -> ubuntu:24.04
ROS_DISTRO_NAME=jazzy
IMAGE_NAME=

# プロキシの設定 （ない場合は空にする）
http_proxy=
https_proxy=
HTTP_PROXY=
HTTPS_PROXY=

# no_proxy=localhost,127.0.0.1 #通したくないホストを指定
# NO_PROXY=localhost,127.0.0.1 #通したくないホストを指定

# プロジェクト名（省略時はフォルダ名）。
# ディストリごとに分離したい場合は有効化を検討。
# COMPOSE_PROJECT_NAME=ros-${ROS_DISTRO_NAME}

# コンテナ名（省略時は start_script が一意な名前を自動生成）
# 固定化したい場合は明示指定：
# CONTAINER_NAME=ros-${ROS_DISTRO_NAME}-docker
